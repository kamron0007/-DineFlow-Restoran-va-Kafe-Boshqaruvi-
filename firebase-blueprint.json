{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Customer table order synced in real time between customer phones, waiter terminals, kitchen KDS, and admin dashboards.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "order_number": { "type": "string", "maxLength": 32 },
        "table_id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "table_number": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["new", "preparing", "ready", "delivered", "cancelled"]
        },
        "total_amount": { "type": "number" },
        "customer_note": { "type": "string", "maxLength": 300 },
        "waiter_called": { "type": "boolean" },
        "bill_requested": { "type": "boolean" },
        "waiter_name": { "type": "string", "maxLength": 100 },
        "customer_account_id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "guest_session_id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "is_settled": { "type": "boolean" },
        "rating": { "type": "number" },
        "items": { "type": "array" },
        "created_at": { "type": "string", "maxLength": 40 },
        "updated_at": { "type": "string", "maxLength": 40 }
      },
      "required": [
        "id",
        "order_number",
        "table_id",
        "table_number",
        "status",
        "total_amount",
        "items",
        "created_at",
        "updated_at"
      ]
    },
    "ServiceCall": {
      "title": "ServiceCall",
      "description": "Real-time waiter call, bill request, or water request sent from a customer table QR screen to waiter and admin screens.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "table_id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "table_number": { "type": "number" },
        "type": { "type": "string", "enum": ["waiter", "bill", "water"] },
        "note": { "type": "string", "maxLength": 250 },
        "call_count": { "type": "number" },
        "escalated_to_admin": { "type": "boolean" },
        "assigned_waiter_name": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "resolved"] },
        "created_at": { "type": "string", "maxLength": 40 },
        "last_called_at": { "type": "string", "maxLength": 40 }
      },
      "required": [
        "id",
        "table_id",
        "table_number",
        "type",
        "status",
        "created_at"
      ]
    },
    "DishReview": {
      "title": "DishReview",
      "description": "Star rating (1-5) and comment left by a customer for a specific menu dish.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "menu_item_id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dish_name": { "type": "string", "maxLength": 120 },
        "table_number": { "type": "number" },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 400 },
        "customer_name": { "type": "string", "maxLength": 60 },
        "created_at": { "type": "string", "maxLength": 40 }
      },
      "required": [
        "id",
        "menu_item_id",
        "dish_name",
        "table_number",
        "rating",
        "comment",
        "created_at"
      ]
    },
    "CustomerFeedback": {
      "title": "CustomerFeedback",
      "description": "Overall service and dining feedback for an order (non-PII fields only).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "order_id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "order_number": { "type": "string", "maxLength": 32 },
        "table_number": { "type": "number" },
        "waiter_name": { "type": "string", "maxLength": 100 },
        "overall_rating": { "type": "number" },
        "food_rating": { "type": "number" },
        "speed_rating": { "type": "number" },
        "waiter_rating": { "type": "number" },
        "atmosphere_rating": { "type": "number" },
        "tags": { "type": "array" },
        "comment": { "type": "string", "maxLength": 500 },
        "customer_name": { "type": "string", "maxLength": 60 },
        "tip_amount": { "type": "number" },
        "created_at": { "type": "string", "maxLength": 40 }
      },
      "required": [
        "id",
        "order_id",
        "order_number",
        "table_number",
        "overall_rating",
        "tags",
        "comment",
        "created_at"
      ]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Restaurant menu dish item synchronized across devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category_id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "price": { "type": "number" },
        "image_url": { "type": "string", "maxLength": 500 },
        "is_available": { "type": "boolean" },
        "preparation_time_minutes": { "type": "number" },
        "calories": { "type": "number" },
        "weight_or_portion": { "type": "string", "maxLength": 60 },
        "tags": { "type": "array" },
        "tier": { "type": "string", "enum": ["oddiy", "biznes", "vip"] },
        "created_at": { "type": "string", "maxLength": 40 },
        "updated_at": { "type": "string", "maxLength": 40 }
      },
      "required": [
        "id",
        "category_id",
        "name",
        "description",
        "price",
        "image_url",
        "is_available",
        "preparation_time_minutes",
        "created_at",
        "updated_at"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Menu category definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 80 },
        "icon": { "type": "string", "maxLength": 40 },
        "image_url": { "type": "string", "maxLength": 500 },
        "sort_order": { "type": "number" },
        "created_at": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "name", "sort_order", "created_at"]
    },
    "RestaurantTable": {
      "title": "RestaurantTable",
      "description": "Restaurant dining table configuration and QR token.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "table_number": { "type": "number" },
        "label": { "type": "string", "maxLength": 80 },
        "zone": {
          "type": "string",
          "enum": ["oddiy", "biznes", "vip", "standard", "business", "main", "terrace"]
        },
        "tier": { "type": "string", "enum": ["oddiy", "biznes", "vip"] },
        "seats": { "type": "number" },
        "qr_token": { "type": "string", "maxLength": 80 },
        "is_active": { "type": "boolean" },
        "assigned_waiter_name": { "type": "string", "maxLength": 100 },
        "created_at": { "type": "string", "maxLength": 40 }
      },
      "required": [
        "id",
        "table_number",
        "zone",
        "seats",
        "qr_token",
        "is_active",
        "created_at"
      ]
    },
    "CustomerAccount": {
      "title": "CustomerAccount",
      "description": "Returning customer loyalty account with hashed phone ID, masked phone display, hashed PIN, and live cashback balance.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "full_name": { "type": "string", "maxLength": 80 },
        "phone_masked": { "type": "string", "maxLength": 30 },
        "pin_hash": { "type": "string", "maxLength": 128 },
        "cashback_balance": { "type": "number" },
        "total_spent": { "type": "number" },
        "total_orders": { "type": "number" },
        "tier": { "type": "string", "enum": ["silver", "gold", "platinum"] },
        "created_at": { "type": "string", "maxLength": 40 },
        "updated_at": { "type": "string", "maxLength": 40 }
      },
      "required": [
        "id",
        "full_name",
        "phone_masked",
        "pin_hash",
        "cashback_balance",
        "total_spent",
        "total_orders",
        "tier",
        "created_at",
        "updated_at"
      ]
    },
    "CashbackTransaction": {
      "title": "CashbackTransaction",
      "description": "Individual cashback earn, spend, refund, or welcome bonus ledger entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "account_id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["earned", "spent", "refunded", "welcome_bonus"] },
        "amount": { "type": "number" },
        "order_id": { "type": "string", "maxLength": 128 },
        "order_number": { "type": "string", "maxLength": 32 },
        "description": { "type": "string", "maxLength": 200 },
        "created_at": { "type": "string", "maxLength": 40 }
      },
      "required": [
        "id",
        "account_id",
        "type",
        "amount",
        "description",
        "created_at"
      ]
    },
    "StaffAccount": {
      "title": "StaffAccount",
      "description": "Staff portal account for Admin, Waiter, or Chef roles using Uzbekistan +998 phone hash ID, masked display phone, and hashed PIN.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["admin", "waiter", "kitchen"] },
        "full_name": { "type": "string", "maxLength": 80 },
        "phone_masked": { "type": "string", "maxLength": 30 },
        "pin_hash": { "type": "string", "maxLength": 128 },
        "badge_id": { "type": "string", "maxLength": 24 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "assigned_tables": { "type": "array" },
        "created_at": { "type": "string", "maxLength": 40 },
        "updated_at": { "type": "string", "maxLength": 40 }
      },
      "required": [
        "id",
        "role",
        "full_name",
        "phone_masked",
        "pin_hash",
        "badge_id",
        "status",
        "created_at",
        "updated_at"
      ]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Real-time table orders shared across customer phones, waiters, kitchen, and admin."
    },
    "/service_calls/{callId}": {
      "schema": { "$ref": "#/entities/ServiceCall" },
      "description": "Real-time waiter calls and bill requests from customer tables."
    },
    "/dish_reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/DishReview" },
      "description": "Customer 1-5 star ratings and comments per dish."
    },
    "/feedbacks/{feedbackId}": {
      "schema": { "$ref": "#/entities/CustomerFeedback" },
      "description": "Overall post-order dining feedbacks (strictly non-PII)."
    },
    "/menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Live restaurant menu catalog."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Menu categories."
    },
    "/tables/{tableId}": {
      "schema": { "$ref": "#/entities/RestaurantTable" },
      "description": "Restaurant table registry."
    },
    "/customer_accounts/{accountId}": {
      "schema": { "$ref": "#/entities/CustomerAccount" },
      "description": "Returning customer loyalty accounts with cashback balance (zero raw PII; lookup by hashed ID only)."
    },
    "/customer_accounts/{accountId}/transactions/{txId}": {
      "schema": { "$ref": "#/entities/CashbackTransaction" },
      "description": "Cashback transaction history belonging to a customer account."
    },
    "/staff_accounts/{staffId}": {
      "schema": { "$ref": "#/entities/StaffAccount" },
      "description": "Staff accounts for Admin, Waiter, and Chef roles (zero raw PII; masked phone and hashed PIN)."
    }
  }
}
